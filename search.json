---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign sep = "" -%}
[
{%- for post in site.posts %}
  {{ sep }}{
    "type": "post",
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }
  {%- assign sep = "," -%}
{%- endfor %}
{%- for project in site.projects %}
  {{ sep }}{
    "type": "project",
    "title": {{ project.title | jsonify }},
    "url": {{ project.url | relative_url | jsonify }},
    "date": {{ project.year | jsonify }},
    "tags": {{ project.stack | default: empty | jsonify }},
    "content": {{ project.summary | append: " " | append: project.content | strip_html | normalize_whitespace | jsonify }}
  }
  {%- assign sep = "," -%}
{%- endfor %}
{%- for page in site.html_pages %}
  {%- if page.title and page.search != false %}
  {%- assign text = page.content | strip_html | normalize_whitespace %}
  {{ sep }}{
    "type": "page",
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "tags": [],
    "content": {{ page.description | append: " " | append: text | strip | jsonify }}
  }
  {%- assign sep = "," -%}
  {%- endif %}
{%- endfor %}
]
