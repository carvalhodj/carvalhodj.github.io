{{- /*
  search.json: every post, project and page in this language, fetched by
  retro.js the first time search opens. Add `search: false` to a page's
  front matter to leave it out.
*/ -}}
{{- $lang := partial "lang-code.html" site.Language }}
{{- $items := slice }}
{{- range where site.RegularPages "Section" "blog" }}
  {{- $items = $items | append (dict
    "type" "post"
    "lang" $lang
    "title" .Title
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
    "tags" (.Params.tags | default slice)
    "content" (.Plain | replaceRE `\s+` " " | strings.TrimSpace)
  ) }}
{{- end }}
{{- range where site.RegularPages "Section" "projects" }}
  {{- $items = $items | append (dict
    "type" "project"
    "lang" $lang
    "title" .Title
    "url" .RelPermalink
    "date" .Params.year
    "tags" (.Params.stack | default slice)
    "content" (printf "%s %s" (.RawSummary | default "") .Plain | replaceRE `\s+` " " | strings.TrimSpace)
  ) }}
{{- end }}
{{- range site.Pages }}
  {{- $isPage := and (eq .Kind "page") (not (in (slice "blog" "projects") .Section)) }}
  {{- if and (or $isPage (in (slice "section" "taxonomy") .Kind)) .Title (ne .Params.search false) }}
  {{- $items = $items | append (dict
    "type" "page"
    "lang" $lang
    "title" .Title
    "url" .RelPermalink
    "tags" slice
    "content" (printf "%s %s" (.Description | default "") .Plain | replaceRE `\s+` " " | strings.TrimSpace)
  ) }}
  {{- end }}
{{- end }}
{{- $items | jsonify -}}
